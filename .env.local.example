# Copia este archivo a .env.local (que ya está en .gitignore, nunca se sube
# a GitHub) y completa los valores reales. Next.js lo carga automáticamente.

# --- Base de datos (Postgres) ---
# Crea un proyecto gratis en https://neon.tech (o Vercel Postgres) y pega
# aquí la cadena de conexión que te dan (empieza con postgresql://...).
DATABASE_URL="postgresql://usuario:contraseña@host/basededatos?sslmode=require"

# --- Envío de correo (Zoho Mail SMTP) ---
# El correo @ureflect.net desde el que se enviarán las notificaciones.
ZOHO_EMAIL="contact@ureflect.net"

# Contraseña de APLICACIÓN de Zoho (no la contraseña normal de la cuenta).
# Se genera en: https://accounts.zoho.com/home#security/app_passwords
ZOHO_APP_PASSWORD=""

# Solo cambiar si tu cuenta de Zoho está en otra región:
# smtp.zoho.eu (Europa), smtp.zoho.in (India), smtp.zoho.com.cn (China).
ZOHO_SMTP_HOST="smtp.zoho.com"

# A dónde llegan las notificaciones de nuevos mensajes del formulario.
# Si lo dejas vacío, se usa ZOHO_EMAIL.
CONTACT_NOTIFY_TO="kvv7794@gmail.com"
