# Copia este archivo a .env.local (que ya está en .gitignore, nunca se sube
# a GitHub) y completa los valores reales. Next.js lo carga automáticamente.
#
# OJO: el CLI de Prisma ("npx prisma db push", "npx prisma generate"...)
# NO lee .env.local — solo lee un archivo llamado exactamente ".env".
# Next.js sí lee ambos (y .env.local tiene prioridad si hay valores
# repetidos). Por eso, cuando uses comandos de Prisma directo en la
# terminal, copia también este archivo a .env:
#   cp .env.local .env
# (.env también está en .gitignore, así que sigue sin subirse a git).

# --- Base de datos (Postgres, vía Neon) ---
# Neon te da DOS cadenas de conexión distintas para el mismo proyecto:
#
# DATABASE_URL: la conexión "pooled" (agrupada, pasa por PgBouncer) — la
#   usa la app en tiempo real. El nombre del host suele terminar en
#   "-pooler" (ej. ep-xxx-pooler.us-east-2.aws.neon.tech).
# DIRECT_URL: la conexión directa (sin agrupar) — la necesita Prisma
#   solo para crear/migrar tablas ("prisma db push"), porque las
#   conexiones agrupadas no soportan ese tipo de operación.
#
# Copia ambas desde el dashboard de tu proyecto en neon.tech
# ("Connection Details" → alterna entre "Pooled connection" y
# "Direct connection").
DATABASE_URL="postgresql://usuario:contraseña@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://usuario:contraseña@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Envío de correo (Zoho Mail SMTP) ---
# El correo @ureflect.net desde el que se enviarán las notificaciones.
ZOHO_EMAIL="contact@ureflect.net"

# Contraseña de APLICACIÓN de Zoho (no la contraseña normal de la cuenta).
# Se genera en: https://accounts.zoho.com/home#security/app_passwords
ZOHO_APP_PASSWORD=""

# Solo cambiar si tu cuenta de Zoho está en otra región:
# smtp.zoho.eu (Europa), smtp.zoho.in (India), smtp.zoho.com.cn (China).
ZOHO_SMTP_HOST="smtp.zoho.com"

# A dónde llegan las notificaciones de nuevos mensajes del formulario.
# Si lo dejas vacío, se usa ZOHO_EMAIL.
CONTACT_NOTIFY_TO="contact@ureflect.net"

# --- Google Analytics (GA4) ---
# El Measurement ID de tu propiedad en analytics.google.com (empieza
# con "G-"). Es información pública (se ve en el código fuente de
# cualquier sitio que lo use), así que NEXT_PUBLIC_ es correcto aquí —
# a diferencia de las demás variables de este archivo, esta SÍ es
# visible en el navegador del visitante.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
